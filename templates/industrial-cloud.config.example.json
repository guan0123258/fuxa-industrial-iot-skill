{
  "industrialCloud": {
    "baseUrl": "https://industrial-cloud.example.com",
    "snapshotEndpoint": "/api/v1/devices/production-line-01/telemetry/latest",
    "method": "GET",
    "timeoutMs": 10000,
    "headers": {
      "Authorization": { "env": "INDUSTRIAL_CLOUD_AUTH", "prefix": "Bearer " }
    },
    "valueRoot": "",
    "mapping": [
      { "sourcePath": "values.pressure", "fuxaTagId": "line01.pressure" },
      { "sourcePath": "values.temperature", "fuxaTagId": "line01.temperature" },
      { "sourcePath": "values.torque", "fuxaTagId": "line01.torque" },
      { "sourcePath": "values.rpm", "fuxaTagId": "line01.rpm" },
      { "sourcePath": "values.load", "fuxaTagId": "line01.load" },
      { "sourcePath": "values.running", "fuxaTagId": "line01.running" }
    ]
  },
  "fuxa": {
    "url": "http://127.0.0.1:1881",
    "apiKeyEnv": "FUXA_API_KEY",
    "usernameEnv": "FUXA_USER",
    "passwordEnv": "FUXA_PASSWORD",
    "insecure": false
  },
  "pollIntervalMs": 3000,
  "staleAfterMs": 15000
}
