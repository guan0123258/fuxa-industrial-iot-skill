{
  "industrialCloud": {
    "baseUrl": "https://industrial-cloud.example.com",
    "snapshotEndpoint": "/api/v1/devices/ship01-main-engine/telemetry/latest",
    "method": "GET",
    "timeoutMs": 10000,
    "headers": {
      "Authorization": { "env": "INDUSTRIAL_CLOUD_AUTH", "prefix": "Bearer " }
    },
    "valueRoot": "",
    "mapping": [
      { "sourcePath": "values.exhaustTemp", "fuxaTagId": "mainEngine.exhaustTemp" },
      { "sourcePath": "values.oilPressure", "fuxaTagId": "mainEngine.oilPressure" },
      { "sourcePath": "values.rpm", "fuxaTagId": "mainEngine.rpm" },
      { "sourcePath": "values.current", "fuxaTagId": "mainEngine.current" },
      { "sourcePath": "values.running", "fuxaTagId": "mainEngine.running" },
      { "sourcePath": "values.runningHours", "fuxaTagId": "mainEngine.runningHours" }
    ]
  },
  "fuxa": {
    "url": "http://127.0.0.1:1881",
    "apiKeyEnv": "FUXA_API_KEY",
    "usernameEnv": "FUXA_USER",
    "passwordEnv": "FUXA_PASSWORD",
    "insecure": false
  },
  "pollIntervalMs": 3000,
  "staleAfterMs": 15000
}
